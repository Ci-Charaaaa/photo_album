<!--
    MainWindow.axaml —— 主界面。
    XAML 是"声明式"的：只描述界面长什么样、绑定到 VM 的哪些属性/命令，
    不写业务逻辑。数据靠 {Binding ...} 与 MainViewModel 关联（DataContext 在代码里设为 MainViewModel）。

    两个命名空间要记住：
      xmlns:vm  —— 引用 ViewModels 程序集，用于 x:DataType 声明"当前绑定的数据类型"
      xmlns:conv—— 引用本项目的值转换器（把 byte[] 转成图片）
    x:DataType="vm:MainViewModel"：开启"编译期绑定"——绑定会在编译时检查，
      写错属性名会编译报错（比运行期才发现强）。
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PhotoAlbum.Presentation.Converters"
        xmlns:vm="clr-namespace:PhotoAlbum.ViewModels;assembly=PhotoAlbum.ViewModels"
        mc:Ignorable="d"
        x:Class="PhotoAlbum.Presentation.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HS相册" Width="1000" Height="720"
        d:DesignWidth="1000" d:DesignHeight="720">

    <Window.Resources>
        <!-- 注册转换器，取个 Key，下面用 {StaticResource BytesToBitmap} 引用 -->
        <conv:BytesToBitmapConverter x:Key="BytesToBitmap" />
    </Window.Resources>

    <!-- 整体布局：左列(树) | 分隔条 | 右列(内容)；下面一行(详情面板) -->
    <Grid ColumnDefinitions="260,4,*" RowDefinitions="*,Auto" Margin="8">

        <!-- 左上：工具栏 + 相册树 -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <!-- 工具栏：按钮的 Command 绑定到 VM 的命令（点按钮 = 执行 VM 方法） -->
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="相册" FontWeight="Bold" Margin="0,0,0,2" />
                <Button Content="全部照片" Command="{Binding ShowAllCommand}" HorizontalAlignment="Stretch" />
                <Button Content="全部相册" Command="{Binding ShowAlbumsCommand}" HorizontalAlignment="Stretch" />
                <Button Content="新建相册" Command="{Binding CreateAlbumCommand}" HorizontalAlignment="Stretch" />
                <Button Content="重命名相册" Command="{Binding RenameAlbumCommand}" HorizontalAlignment="Stretch" />
                <Button Content="相册备注" Command="{Binding UpdateAlbumRemarkCommand}" HorizontalAlignment="Stretch" />
                <Button Content="删除相册" Command="{Binding DeleteAlbumCommand}" HorizontalAlignment="Stretch" />

                <TextBlock Text="照片" FontWeight="Bold" Margin="0,8,0,2" />
                <Button Content="查看原图" Command="{Binding ViewOriginalCommand}" HorizontalAlignment="Stretch" />
                <Button Content="导入照片" Command="{Binding ImportPhotosCommand}" HorizontalAlignment="Stretch" />
                <Button Content="重命名照片" Command="{Binding RenamePhotoCommand}" HorizontalAlignment="Stretch" />
                <Button Content="照片备注" Command="{Binding UpdatePhotoRemarkCommand}" HorizontalAlignment="Stretch" />
                <Button Content="移动照片" Command="{Binding MovePhotoCommand}" HorizontalAlignment="Stretch" />
                <Button Content="删除照片" Command="{Binding DeletePhotoCommand}" HorizontalAlignment="Stretch" />
                <Button Content="批量移动" Command="{Binding MoveSelectedPhotosCommand}" HorizontalAlignment="Stretch" />
                <Button Content="批量删除" Command="{Binding DeleteSelectedPhotosCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!--
                相册树。
                ItemsSource=根节点集合；SelectedItem 双向绑定到 VM.SelectedAlbum：
                  用户点树 -> VM.SelectedAlbum 变 -> VM 重新加载视图；
                  VM 里改 SelectedAlbum -> 树上选中项也跟着变。
                TreeDataTemplate 的 ItemsSource="{Binding Children}"：告诉 TreeView 子节点从哪来（递归成树）。
            -->
            <TreeView ItemsSource="{Binding AlbumTree}"
                      SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:AlbumNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <!-- 备注作为灰色小字第二行，长了就省略号 -->
                            <TextBlock Text="{Binding Remark}" FontSize="11" Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <!-- 可拖动的竖直分隔条（左右宽度可调） -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Background="#22000000" HorizontalAlignment="Stretch" />

        <!-- 右上：三行 —— 返回键 / 子相册条 / 主区 -->
        <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,Auto,*">

            <!-- 返回上级：只有"在相册内"时才可见（绑定 CanGoBack） -->
            <Button Grid.Row="0" Content="← 返回" Command="{Binding GoBackCommand}"
                    IsVisible="{Binding CanGoBack}" HorizontalAlignment="Left" Margin="0,0,0,6" />

            <!--
                子相册条：打开"含子相册的相册"时显示（绑定 ShowChildAlbums）。
                相册卡片用 ItemsControl（不用 ListBox，因为不需要"选中"）：
                每个卡片是一个 Button，命令直接用卡片自己的 OpenCommand（点卡片=打开该相册）。
            -->
            <ScrollViewer Grid.Row="1" MaxHeight="210" IsVisible="{Binding ShowChildAlbums}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AlbumCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />   <!-- 横向排列，排不下自动换行 -->
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumCardViewModel">
                            <Button Command="{Binding OpenCommand}" Background="Transparent"
                                    BorderThickness="0" Padding="0" Margin="6">
                                <StackPanel Width="120">
                                    <!-- 深灰底：没有封面照片时露出它，就是"深灰空置" -->
                                    <Border Background="#FF4A4A4A" Height="100">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToBitmap}}"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--
                主区：照片网格。
                SelectionMode=Multiple：支持 Ctrl/Shift 多选；框选由代码里的指针事件处理。
                SelectionChanged：选中变化时把 ListBox 的选中项同步进 VM.SelectedPhotos（供批量操作）。
            -->
            <ListBox x:Name="PhotoList"
                     Grid.Row="2"
                     ItemsSource="{Binding Photos}"
                     SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnPhotoSelectionChanged"
                     IsVisible="{Binding ShowPhotos}"
                     DoubleTapped="OnPhotoDoubleTapped"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhotoItemViewModel">
                        <StackPanel Width="150" Margin="6">
                            <Border Background="#11000000" Height="130">
                                <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToBitmap}}"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Remark}" TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                       MaxHeight="30" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                主区（切换）：全部相册画廊。
                与照片网格占同一格(Row=2)，通过 IsVisible 互斥切换（同一时刻只显示一个）。
            -->
            <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowGallery}"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AlbumCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumCardViewModel">
                            <Button Command="{Binding OpenCommand}" Background="Transparent"
                                    BorderThickness="0" Padding="0" Margin="8">
                                <StackPanel Width="160">
                                    <Border Background="#FF4A4A4A" Height="140">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToBitmap}}"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--
                框选矩形覆盖层：IsHitTestVisible=False 表示它不接收鼠标事件（只负责画）。
                按住右键拖拽时，代码在这里画一个矩形，并算出被框住的照片。
            -->
            <Canvas Grid.Row="2" x:Name="SelectionCanvas" IsHitTestVisible="False">
                <Rectangle x:Name="SelectionRect" IsVisible="False"
                           Fill="#33007ACC" Stroke="#FF007ACC" StrokeThickness="1" />
            </Canvas>
        </Grid>

        <!--
            底部详情面板：显示当前选中相册/照片的备注。
            用 StringFormat 在绑定值前加前缀；跨三列(Row=1, ColumnSpan=3)。
        -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                BorderBrush="#22000000" BorderThickness="0,1,0,0"
                Padding="8" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="120">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedAlbum.Name, StringFormat='相册：{0}'}" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedAlbum.Remark, StringFormat='相册备注：{0}'}"
                               TextWrapping="Wrap" Foreground="#444444" />
                    <TextBlock Text="{Binding SelectedPhoto.Name, StringFormat='照片：{0}'}"
                               FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedPhoto.Remark, StringFormat='照片备注：{0}'}"
                               TextWrapping="Wrap" Foreground="#444444" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
